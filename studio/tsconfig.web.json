{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "outDir": "node_modules/.tsbuild/web",
    "tsBuildInfoFile": "node_modules/.tsbuild/web.tsbuildinfo"
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*"],
  "exclude": ["src/shared/**/*.test.ts", "src/main/**/*.test.ts"]
}
