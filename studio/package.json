{
  "name": "spm-studio",
  "version": "0.1.0",
  "description": "SPM Studio: engineering and operator studio for SPM machines (Electron + React).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "gen": "node tools/gen-types.mts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" tools",
    "test": "vitest run",
    "mock-runtime": "node tools/mock-runtime.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "web": "vite src/renderer --config vite.web.config.ts",
    "build:web": "vite build src/renderer --config vite.web.config.ts",
    "postinstall": "node node_modules/electron/install.js || echo Electron program download skipped",
    "test:ui": "playwright test",
    "test:watch": "vitest",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --ui"
  },
  "author": "Arun P",
  "license": "UNLICENSED",
  "dependencies": {
    "ajv": "^8.20.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true
}
